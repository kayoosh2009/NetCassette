import { LineEdit } from "std-widgets.slint";

component SpoolWheel inherits Rectangle {
    in property <bool> active: false;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: #18181f;
    border-width: 2px;
    border-color: #525266;

    Rectangle {
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: #ffffff;
    }

    Rectangle {
        width: 4px;
        height: 24px;
        background: #393946;
        border-radius: 1px;
    }

    Rectangle {
        width: 24px;
        height: 4px;
        background: #393946;
        border-radius: 1px;
    }
}

export component MainWindow inherits Window {
    title: "NetCassette Widget";
    no-frame: true;
    background: transparent;
    always-on-top: true;
    width: 380px;
    height: 280px;

    in-out property <bool> is-playing: false;
    in-out property <int> peer-count: 0;
    in-out property <string> track-title: "Swarm Idle";
    in-out property <string> stream-status: "Ready";
    in-out property <bool> is-expanded: hover-zone.has-hover || panel-zone.has-hover;

    callback toggle-playback();
    callback connect-peer(string);
    callback close-widget();

    // Hot-edge trigger zone on the far right
    hover-zone := TouchArea {
        x: root.width - 20px;
        y: 0px;
        width: 20px;
        height: root.height;
    }

    // Main sliding card body
    panel-zone := TouchArea {
        x: root.is-expanded ? (root.width - 360px) : (root.width - 16px);
        y: 10px;
        width: 360px;
        height: 260px;

        animate x {
            duration: 250ms;
            easing: ease-out;
        }

        Rectangle {
            background: #141419;
            border-radius: 14px;
            border-width: 1.5px;
            border-color: #ff8838;
            clip: true;

            // Cassette side tab visible when collapsed
            Rectangle {
                x: 0px;
                y: 0px;
                width: 6px;
                height: parent.height;
                background: #ff8838;
            }

            VerticalLayout {
                padding-top: 14px;
                padding-bottom: 14px;
                padding-left: 20px;
                padding-right: 16px;
                spacing: 10px;

                // Title bar
                HorizontalLayout {
                    alignment: space-between;
                    height: 22px;

                    Text {
                        text: "NETCASSETTE // P2P";
                        color: #ff8838;
                        font-size: 11px;
                        font-weight: 800;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        width: 22px;
                        height: 22px;
                        clicked => { root.close-widget(); }
                        Text {
                            text: "×";
                            color: #727282;
                            font-size: 18px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Compact cassette viewport
                Rectangle {
                    height: 78px;
                    background: #1d1d26;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #2b2b38;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        // Sticker label
                        Rectangle {
                            height: 22px;
                            background: #f1ebd9;
                            border-radius: 3px;
                            clip: true;

                            Text {
                                text: root.track-title;
                                color: #151515;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Reel window
                        HorizontalLayout {
                            alignment: space-around;
                            vertical-alignment: center;

                            SpoolWheel { active: root.is-playing; }

                            Text {
                                text: root.is-playing ? "STREAMING" : root.stream-status;
                                color: root.is-playing ? #4ade80 : #9a9ab0;
                                font-size: 10px;
                                font-weight: 600;
                            }

                            SpoolWheel { active: root.is-playing; }
                        }
                    }
                }

                // Swarm room connection input
                HorizontalLayout {
                    spacing: 8px;
                    height: 30px;

                    input := LineEdit {
                        placeholder-text: "Room ID / Peer...";
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 70px;
                        background: #ff8838;
                        border-radius: 4px;

                        TouchArea {
                            clicked => { root.connect-peer(input.text); }
                            Text {
                                text: "JOIN";
                                color: #111115;
                                font-size: 11px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Deck controls & peer counter
                HorizontalLayout {
                    alignment: space-between;
                    vertical-alignment: center;

                    // Play/Pause Deck Button
                    Rectangle {
                        width: 100px;
                        height: 32px;
                        background: root.is-playing ? #f43f5e : #22c55e;
                        border-radius: 6px;

                        TouchArea {
                            clicked => { root.toggle-playback(); }
                            Text {
                                text: root.is-playing ? "PAUSE" : "PLAY";
                                color: #ffffff;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: "● " + root.peer-count + " peers";
                        color: root.peer-count > 0 ? #4ade80 : #71717a;
                        font-size: 11px;
                        font-weight: 600;
                    }
                }
            }
        }
    }
}