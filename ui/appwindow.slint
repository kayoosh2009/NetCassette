component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> is-active: false;
    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: touch.pressed ? #3d3d3d : (touch.has-hover ? #323232 : transparent);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Image {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        image-fit: contain;
    }
}

export component MainWindow inherits Window {
    title: "NetCassette";
    no-frame: true;
    background: transparent;
    always-on-top: true;
    width: menu-open ? 680px : 360px;
    height: menu-open ? 380px : 270px;

    animate width, height {
        duration: 250ms;
        easing: ease-out;
    }

    in-out property <bool> is-playing: false;
    in-out property <bool> menu-open: false;
    in-out property <string> track-title: "Midnight Transmission";
    in-out property <string> track-artist: "P2P Stream Swarm";
    in-out property <image> track-cover: @image-url("icons/play.png");

    callback play-clicked();
    callback stop-clicked();
    callback next-clicked();
    callback prev-clicked();
    callback toggle-menu();
    callback minimize-clicked();
    callback close-clicked();

    Rectangle {
        width: 100%;
        height: 100%;
        background: #262626;
        border-radius: 14px;
        border-width: 1px;
        border-color: #383838;
        clip: true;

        HorizontalLayout {
            padding: 14px;
            spacing: 14px;

            // Main 4:3 Player Deck Area
            VerticalLayout {
                width: 332px;
                spacing: 10px;

                // Header & Window Actions
                HorizontalLayout {
                    height: 22px;
                    alignment: space-between;

                    Text {
                        text: "NETCASSETTE";
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 800;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }

                    // Window controls (_ and X)
                    HorizontalLayout {
                        spacing: 8px;

                        TouchArea {
                            width: 22px;
                            height: 22px;
                            clicked => { root.minimize-clicked(); }
                            Text {
                                text: "_";
                                color: #8a8a8a;
                                font-size: 14px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: top;
                            }
                        }

                        TouchArea {
                            width: 22px;
                            height: 22px;
                            clicked => { root.close-clicked(); }
                            Text {
                                text: "✕";
                                color: #8a8a8a;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Song Artwork / Cover Viewport
                Rectangle {
                    background: #1c1c1c;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #333333;
                    vertical-stretch: 1;
                    clip: true;

                    // Background artwork icon
                    Image {
                        width: 72px;
                        height: 72px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2 - 12px;
                        source: root.track-cover;
                        image-fit: contain;
                    }

                    // Bottom title banner overlay
                    VerticalLayout {
                        alignment: end;
                        padding-bottom: 10px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 2px;

                        Text {
                            text: root.track-title;
                            color: #ffffff;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            text: root.track-artist;
                            color: #8e8e8e;
                            font-size: 11px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Bottom Control Bar
                HorizontalLayout {
                    height: 40px;
                    alignment: space-between;

                    IconButton {
                        icon: @image-url("icons/prev.png");
                        clicked => { root.prev-clicked(); }
                    }

                    IconButton {
                        icon: @image-url("icons/play.png");
                        clicked => { root.play-clicked(); }
                    }

                    IconButton {
                        icon: @image-url("icons/stop.png");
                        clicked => { root.stop-clicked(); }
                    }

                    IconButton {
                        icon: @image-url("icons/next.png");
                        clicked => { root.next-clicked(); }
                    }

                    Rectangle {
                        width: 1px;
                        height: 22px;
                        y: 9px;
                        background: #3e3e3e;
                    }

                    IconButton {
                        icon: @image-url("icons/menu.png");
                        clicked => { root.toggle-menu(); }
                    }
                }
            }

            // Expanded Playlist & Swarm Sidebar
            if root.menu-open : Rectangle {
                background: #1d1d1d;
                border-radius: 10px;
                border-width: 1px;
                border-color: #333333;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: space-between;
                        height: 22px;

                        Text {
                            text: "PLAYLIST & SWARMS";
                            color: #ffffff;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "3 TAPES";
                            color: #6d6d6d;
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    // Tape list container placeholder
                    VerticalLayout {
                        spacing: 8px;

                        Rectangle {
                            height: 38px;
                            background: #2b2b2b;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;
                                Text {
                                    text: "▸ 01. Cyber-Synth Tape";
                                    color: #ffffff;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "LIVE";
                                    color: #4ade80;
                                    font-size: 9px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 38px;
                            background: #242424;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;
                                Text {
                                    text: "  02. Lo-Fi Beats Node";
                                    color: #a0a0a0;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "PAUSED";
                                    color: #737373;
                                    font-size: 9px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 38px;
                            background: #242424;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: space-between;
                                Text {
                                    text: "  03. Ambient Archive";
                                    color: #a0a0a0;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "IDLE";
                                    color: #737373;
                                    font-size: 9px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}