import { PlaylistWindow } from "playlist.slint";
export { PlaylistWindow }

export struct TrackItem {
    id: string,
    title: string,
    artist: string,
    duration: string,
    status: string,
    progress: float,
    is-downloaded: bool,
    is-playing: bool,
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> is-active: false;
    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: touch.pressed ? #3d3d3d : (touch.has-hover ? #323232 : transparent);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Image {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        image-fit: contain;
    }
}

export component MainWindow inherits Window {
    title: "NetCassette";
    no-frame: true;
    background: transparent;
    always-on-top: true;
    width: root.base-width;
    height: root.base-height;

    in-out property <length> base-width: 360px;
    in-out property <length> base-height: 270px;
    in-out property <bool> is-playing: false;
    in-out property <bool> menu-open: false;
    in-out property <bool> is-revealed: true;
    in-out property <bool> has-hover: hover-sensor.has-hover;
    in-out property <string> track-title: "No Media Loaded";
    in-out property <string> track-artist: "Ready";
    in-out property <image> track-cover: @image-url("icons/play.png");

    in-out property <length> drag-last-y: 0px;
    in-out property <length> resize-last-x: 0px;
    in-out property <length> resize-last-y: 0px;

    callback play-clicked();
    callback stop-clicked();
    callback next-clicked();
    callback prev-clicked();
    callback toggle-menu();
    callback hover-changed(bool);
    callback move-window-y(length);
    callback resize-window(length, length);
    callback quit-app();
    callback track-selected(int);
    callback add-torrent-clicked(string);
    callback download-track-clicked(int);

    in-out property <[TrackItem]> playlist: [];
    in-out property <string> torrent-input: "";

    // Hover & LMB vertical drag sensor
    hover-sensor := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: self.pressed ? row-resize : default;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.drag-last-y = self.mouse-y;
            }
        }

        moved => {
            root.hover-changed(self.has-hover);
            if self.pressed {
                let dy = self.mouse-y - root.drag-last-y;
                root.drag-last-y = self.mouse-y;
                root.move-window-y(dy);
            }
        }
    }

    // Sliding drawer panel with semi-transparent tucked state
    card := Rectangle {
        x: (root.is-revealed || root.menu-open) ? 0px : (root.width - 8px);
        y: 0px;
        width: root.width;
        height: root.height;
        background: #262626;
        border-radius: 14px;
        border-width: 1px;
        border-color: #383838;
        clip: true;

        opacity: (root.is-revealed || root.menu-open) ? 1.0 : 0.35;

        animate x, opacity {
            duration: 220ms;
            easing: ease-out;
        }

        // Accent edge indicator when tucked
        Rectangle {
            x: 0px;
            y: 0px;
            width: 3px;
            height: parent.height;
            background: #ffffff;
            opacity: (root.is-revealed || root.menu-open) ? 0.0 : 0.7;
        }

        // Bottom-left corner resize handle
        resize-handle := TouchArea {
            x: 0px;
            y: parent.height - 20px;
            width: 20px;
            height: 20px;
            mouse-cursor: nesw-resize;

            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.resize-last-x = self.mouse-x;
                    root.resize-last-y = self.mouse-y;
                }
            }

            moved => {
                if self.pressed {
                    let dw = root.resize-last-x - self.mouse-x;
                    let dh = self.mouse-y - root.resize-last-y;
                    root.resize-last-x = self.mouse-x;
                    root.resize-last-y = self.mouse-y;
                    root.resize-window(dw, dh);
                }
            }

            // Visual corner grip dots
            Rectangle {
                width: 3px;
                height: 3px;
                x: 4px;
                y: parent.height - 7px;
                border-radius: 1.5px;
                background: #555555;
            }
            Rectangle {
                width: 3px;
                height: 3px;
                x: 8px;
                y: parent.height - 7px;
                border-radius: 1.5px;
                background: #555555;
            }
            Rectangle {
                width: 3px;
                height: 3px;
                x: 4px;
                y: parent.height - 11px;
                border-radius: 1.5px;
                background: #555555;
            }
        }

        VerticalLayout {
            padding: 14px;
            spacing: 12px;

            // Main 4:3 Player Area (Elastic Top Deck)
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 10px;

                // Simple Top Bar
                HorizontalLayout {
                    height: 20px;
                    alignment: space-between;

                    Text {
                        text: "NETCASSETTE";
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 800;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.is-playing ? #22c55e : #6b7280;
                        y: 6px;
                    }
                }

                // Center Song Cover / Info Viewport with Full Artwork Background
                Rectangle {
                    background: #1c1c1c;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #333333;
                    vertical-stretch: 1;
                    clip: true;

                    // Full Cover Background Image
                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.track-cover;
                        image-fit: cover;
                    }

                    // Dark gradient scrim for text readability
                    Rectangle {
                        background: @linear-gradient(180deg, rgba(18, 18, 22, 0.25) 0%, rgba(14, 14, 18, 0.88) 100%);
                    }

                    VerticalLayout {
                        alignment: end;
                        padding-bottom: 12px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 2px;

                        Text {
                            text: root.track-title;
                            color: #ffffff;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            text: root.track-artist;
                            color: #cccccc;
                            font-size: 11px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Bottom Control Bar
                HorizontalLayout {
                    height: 40px;
                    alignment: space-between;

                    IconButton {
                        icon: @image-url("icons/prev.png");
                        clicked => { root.prev-clicked(); }
                    }

                    // Dynamic Play / Stop Toggle Button
                    IconButton {
                        icon: root.is-playing ? @image-url("icons/stop.png") : @image-url("icons/play.png");
                        clicked => { root.play-clicked(); }
                    }

                    IconButton {
                        icon: @image-url("icons/next.png");
                        clicked => { root.next-clicked(); }
                    }

                    Rectangle {
                        width: 1px;
                        height: 22px;
                        y: 9px;
                        background: #3e3e3e;
                    }

                    IconButton {
                        icon: @image-url("icons/menu.png");
                        clicked => { root.toggle-menu(); }
                    }
                }
            }

            
        }
    }
}