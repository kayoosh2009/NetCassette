export struct TrackItem {
    id: string,
    title: string,
    artist: string,
    duration: string,
    status: string,
    progress: float,
    is-downloaded: bool,
    is-playing: bool,
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> is-active: false;
    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: touch.pressed ? #3d3d3d : (touch.has-hover ? #323232 : transparent);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Image {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        image-fit: contain;
    }
}

export component MainWindow inherits Window {
    title: "NetCassette";
    no-frame: true;
    background: transparent;
    always-on-top: true;
    width: root.base-width;
    height: menu-open ? (root.base-height + 340px) : root.base-height;

    animate height {
        duration: 220ms;
        easing: ease-out;
    }

    in-out property <length> base-width: 360px;
    in-out property <length> base-height: 270px;
    in-out property <bool> is-playing: false;
    in-out property <bool> menu-open: false;
    in-out property <bool> is-revealed: true;
    in-out property <bool> has-hover: hover-sensor.has-hover;
    in-out property <string> track-title: "No Media Loaded";
    in-out property <string> track-artist: "Ready";
    in-out property <image> track-cover: @image-url("icons/play.png");

    in-out property <length> drag-last-y: 0px;
    in-out property <length> resize-last-x: 0px;
    in-out property <length> resize-last-y: 0px;

    callback play-clicked();
    callback stop-clicked();
    callback next-clicked();
    callback prev-clicked();
    callback toggle-menu();
    callback hover-changed(bool);
    callback move-window-y(length);
    callback resize-window(length, length);
    callback quit-app();
    callback track-selected(int);
    callback add-torrent-clicked(string);
    callback download-track-clicked(int);

    in-out property <[TrackItem]> playlist: [];
    in-out property <string> torrent-input: "";

    // Hover & LMB vertical drag sensor
    hover-sensor := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: self.pressed ? row-resize : default;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.drag-last-y = self.mouse-y;
            }
        }

        moved => {
            root.hover-changed(self.has-hover);
            if self.pressed {
                let dy = self.mouse-y - root.drag-last-y;
                root.drag-last-y = self.mouse-y;
                root.move-window-y(dy);
            }
        }
    }

    // Sliding drawer panel with semi-transparent tucked state
    card := Rectangle {
        x: (root.is-revealed || root.menu-open) ? 0px : (root.width - 8px);
        y: 0px;
        width: root.width;
        height: root.height;
        background: #262626;
        border-radius: 14px;
        border-width: 1px;
        border-color: #383838;
        clip: true;

        opacity: (root.is-revealed || root.menu-open) ? 1.0 : 0.35;

        animate x, opacity {
            duration: 220ms;
            easing: ease-out;
        }

        // Accent edge indicator when tucked
        Rectangle {
            x: 0px;
            y: 0px;
            width: 3px;
            height: parent.height;
            background: #ffffff;
            opacity: (root.is-revealed || root.menu-open) ? 0.0 : 0.7;
        }

        // Bottom-left corner resize handle
        resize-handle := TouchArea {
            x: 0px;
            y: parent.height - 20px;
            width: 20px;
            height: 20px;
            mouse-cursor: nesw-resize;

            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.resize-last-x = self.mouse-x;
                    root.resize-last-y = self.mouse-y;
                }
            }

            moved => {
                if self.pressed {
                    let dw = root.resize-last-x - self.mouse-x;
                    let dh = self.mouse-y - root.resize-last-y;
                    root.resize-last-x = self.mouse-x;
                    root.resize-last-y = self.mouse-y;
                    root.resize-window(dw, dh);
                }
            }

            // Visual corner grip dots
            Rectangle {
                width: 3px;
                height: 3px;
                x: 4px;
                y: parent.height - 7px;
                border-radius: 1.5px;
                background: #555555;
            }
            Rectangle {
                width: 3px;
                height: 3px;
                x: 8px;
                y: parent.height - 7px;
                border-radius: 1.5px;
                background: #555555;
            }
            Rectangle {
                width: 3px;
                height: 3px;
                x: 4px;
                y: parent.height - 11px;
                border-radius: 1.5px;
                background: #555555;
            }
        }

        VerticalLayout {
            padding: 14px;
            spacing: 12px;

            // Main 4:3 Player Area (Elastic Top Deck)
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 10px;

                // Simple Top Bar
                HorizontalLayout {
                    height: 20px;
                    alignment: space-between;

                    Text {
                        text: "NETCASSETTE";
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 800;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.is-playing ? #22c55e : #6b7280;
                        y: 6px;
                    }
                }

                // Center Song Cover / Info Viewport with Full Artwork Background
                Rectangle {
                    background: #1c1c1c;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #333333;
                    vertical-stretch: 1;
                    clip: true;

                    // Full Cover Background Image
                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.track-cover;
                        image-fit: cover;
                    }

                    // Dark gradient scrim for text readability
                    Rectangle {
                        background: @linear-gradient(180deg, rgba(18, 18, 22, 0.25) 0%, rgba(14, 14, 18, 0.88) 100%);
                    }

                    VerticalLayout {
                        alignment: end;
                        padding-bottom: 12px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 2px;

                        Text {
                            text: root.track-title;
                            color: #ffffff;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            text: root.track-artist;
                            color: #cccccc;
                            font-size: 11px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Bottom Control Bar
                HorizontalLayout {
                    height: 40px;
                    alignment: space-between;

                    IconButton {
                        icon: @image-url("icons/prev.png");
                        clicked => { root.prev-clicked(); }
                    }

                    // Dynamic Play / Stop Toggle Button
                    IconButton {
                        icon: root.is-playing ? @image-url("icons/stop.png") : @image-url("icons/play.png");
                        clicked => { root.play-clicked(); }
                    }

                    IconButton {
                        icon: @image-url("icons/next.png");
                        clicked => { root.next-clicked(); }
                    }

                    Rectangle {
                        width: 1px;
                        height: 22px;
                        y: 9px;
                        background: #3e3e3e;
                    }

                    IconButton {
                        icon: @image-url("icons/menu.png");
                        clicked => { root.toggle-menu(); }
                    }
                }
            }

            // Downward Expanded Menu Section
            if root.menu-open : Rectangle {
                height: 330px;
                background: #1d1d1d;
                border-radius: 10px;
                border-width: 1px;
                border-color: #333333;

                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    HorizontalLayout {
                        height: 16px;
                        alignment: space-between;

                        Text {
                            text: "SWARM QUEUE & SYNC";
                            color: #ffffff;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 1px;
                        }

                        Text {
                            text: @tr("{0} tracks", root.playlist.length);
                            color: #888888;
                            font-size: 10px;
                        }
                    }

                    // Magnet / Torrent Hash Input
                    Rectangle {
                        height: 32px;
                        background: #161616;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #2f2f2f;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 4px;
                            spacing: 6px;

                            TextInput {
                                text <=> root.torrent-input;
                                color: #ffffff;
                                font-size: 11px;
                                vertical-alignment: center;
                                accepted => {
                                    if root.torrent-input != "" {
                                        root.add-torrent-clicked(root.torrent-input);
                                        root.torrent-input = "";
                                    }
                                }
                            }

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                y: 4px;
                                border-radius: 4px;
                                background: add-touch.pressed ? #3e3e3e : (add-touch.has-hover ? #2e2e2e : #222222);

                                add-touch := TouchArea {
                                    clicked => {
                                        if root.torrent-input != "" {
                                            root.add-torrent-clicked(root.torrent-input);
                                            root.torrent-input = "";
                                        }
                                    }
                                }

                                Text {
                                    text: "+";
                                    color: #4ade80;
                                    font-size: 14px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Playlist Viewport
                    Rectangle {
                        background: #151515;
                        border-radius: 8px;
                        vertical-stretch: 1;
                        clip: true;

                        if root.playlist.length == 0 : Text {
                            text: "No swarms in queue\nPaste magnet or torrent hash above";
                            color: #555555;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        Flickable {
                            viewport-height: tracks-col.min-height;

                            tracks-col := VerticalLayout {
                                spacing: 2px;
                                padding: 4px;

                                for track[idx] in root.playlist : Rectangle {
                                    height: 42px;
                                    border-radius: 6px;
                                    background: track.is-playing ? #26262a : (row-touch.has-hover ? #1f1f1f : transparent);

                                    row-touch := TouchArea {
                                        clicked => { root.track-selected(idx); }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;

                                        // Play state indicator or index
                                        Text {
                                            width: 14px;
                                            text: track.is-playing ? "▶" : @tr("{0}", idx + 1);
                                            color: track.is-playing ? #22c55e : #666666;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }

                                        // Track metadata
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 1px;
                                            horizontal-stretch: 1;

                                            Text {
                                                text: track.title;
                                                color: track.is-playing ? #ffffff : #dddddd;
                                                font-size: 11px;
                                                font-weight: track.is-playing ? 700 : 500;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: track.artist;
                                                color: #777777;
                                                font-size: 9px;
                                                overflow: elide;
                                            }
                                        }

                                        // Download status & progress badge
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            width: 60px;

                                            Text {
                                                text: track.status;
                                                color: track.is-downloaded ? #22c55e : #eab308;
                                                font-size: 9px;
                                                horizontal-alignment: end;
                                                overflow: elide;
                                            }

                                            if !track.is-downloaded : Rectangle {
                                                height: 3px;
                                                background: #2a2a2a;
                                                border-radius: 1.5px;

                                                Rectangle {
                                                    x: 0px;
                                                    width: parent.width * track.progress;
                                                    height: parent.height;
                                                    background: #eab308;
                                                    border-radius: 1.5px;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Exit Widget Action
                    Rectangle {
                        height: 30px;
                        background: #231b1b;
                        border-radius: 6px;

                        TouchArea {
                            clicked => { root.quit-app(); }
                            Text {
                                text: "Quit NetCassette";
                                color: #f87171;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}