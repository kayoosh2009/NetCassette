component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> is-active: false;
    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: touch.pressed ? #3d3d3d : (touch.has-hover ? #323232 : transparent);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Image {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        image-fit: contain;
    }
}

export component MainWindow inherits Window {
    title: "NetCassette";
    no-frame: true;
    background: transparent;
    always-on-top: true;
    width: menu-open ? 680px : 360px;
    height: menu-open ? 380px : 270px;

    animate width, height {
        duration: 250ms;
        easing: ease-out;
    }

    in-out property <bool> is-playing: false;
    in-out property <bool> menu-open: false;
    in-out property <bool> is-revealed: true;
    in-out property <bool> has-hover: hover-sensor.has-hover;
    in-out property <string> track-title: "No Media Loaded";
    in-out property <string> track-artist: "Ready";
    in-out property <image> track-cover: @image-url("icons/play.png");

    in-out property <bool> shift-pressed: false;
    in-out property <length> drag-start-x: 0px;
    in-out property <length> drag-start-y: 0px;

    callback play-clicked();
    callback stop-clicked();
    callback next-clicked();
    callback prev-clicked();
    callback toggle-menu();
    callback hover-changed(bool);
    callback move-window(length, length);

    forward-focus: key-scope;
    key-scope := FocusScope {
        key-pressed(e) => {
            if e.modifiers.shift { root.shift-pressed = true; }
            reject
        }
        key-released(e) => {
            if !e.modifiers.shift { root.shift-pressed = false; }
            reject
        }
    }

    // Hover & drag sensor covering the full viewport
    hover-sensor := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: root.shift-pressed ? move : default;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.drag-start-x = self.mouse-x;
                root.drag-start-y = self.mouse-y;
            }
        }

        moved => {
            root.hover-changed(self.has-hover);
            if self.pressed && root.shift-pressed {
                root.move-window(self.mouse-x - root.drag-start-x, self.mouse-y - root.drag-start-y);
            }
        }
    }

    // Sliding drawer panel
    card := Rectangle {
        x: (root.is-revealed || root.menu-open) ? 0px : (root.width - 8px);
        y: 0px;
        width: root.width;
        height: root.height;
        background: #262626;
        border-radius: 14px;
        border-width: 1px;
        border-color: #383838;
        clip: true;

        animate x {
            duration: 220ms;
            easing: ease-out;
        }

        HorizontalLayout {
            padding: 14px;
            spacing: 14px;

            // Main 4:3 Player Area
            VerticalLayout {
                width: 332px;
                spacing: 10px;

                // Simple Top Bar
                HorizontalLayout {
                    height: 20px;
                    alignment: space-between;

                    Text {
                        text: "NETCASSETTE";
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 800;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.is-playing ? #22c55e : #6b7280;
                        y: 6px;
                    }
                }

                // Center Song Cover / Info Viewport
                Rectangle {
                    background: #1c1c1c;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #333333;
                    vertical-stretch: 1;
                    clip: true;

                    Image {
                        width: 64px;
                        height: 64px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2 - 14px;
                        source: root.track-cover;
                        image-fit: contain;
                    }

                    VerticalLayout {
                        alignment: end;
                        padding-bottom: 10px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 2px;

                        Text {
                            text: root.track-title;
                            color: #ffffff;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            text: root.track-artist;
                            color: #888888;
                            font-size: 11px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Bottom Control Bar
                HorizontalLayout {
                    height: 40px;
                    alignment: space-between;

                    IconButton {
                        icon: @image-url("icons/prev.png");
                        clicked => { root.prev-clicked(); }
                    }

                    IconButton {
                        icon: @image-url("icons/play.png");
                        clicked => { root.play-clicked(); }
                    }

                    IconButton {
                        icon: @image-url("icons/stop.png");
                        clicked => { root.stop-clicked(); }
                    }

                    IconButton {
                        icon: @image-url("icons/next.png");
                        clicked => { root.next-clicked(); }
                    }

                    Rectangle {
                        width: 1px;
                        height: 22px;
                        y: 9px;
                        background: #3e3e3e;
                    }

                    IconButton {
                        icon: @image-url("icons/menu.png");
                        clicked => { root.toggle-menu(); }
                    }
                }
            }

            // Clean Menu Section (Opens on demand)
            if root.menu-open : Rectangle {
                background: #1d1d1d;
                border-radius: 10px;
                border-width: 1px;
                border-color: #333333;
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    Text {
                        text: "PLAYLIST & SWARMS";
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 700;
                    }

                    Rectangle {
                        background: #171717;
                        border-radius: 8px;
                        vertical-stretch: 1;

                        Text {
                            text: "Queue is empty";
                            color: #555555;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}