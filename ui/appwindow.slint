component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> is-active: false;
    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: touch.pressed ? #3d3d3d : (touch.has-hover ? #323232 : transparent);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Image {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: #ffffff;
    }
}

export component MainWindow inherits Window {
    title: "NetCassette";
    no-frame: true;
    background: transparent;
    always-on-top: true;
    width: 320px;
    height: menu-open ? 260px : 56px;

    animate height {
        duration: 200ms;
        easing: ease-out;
    }

    in-out property <bool> is-playing: false;
    in-out property <bool> menu-open: false;
    in-out property <string> track-title: "No Stream Selected";

    callback play-clicked();
    callback stop-clicked();
    callback next-clicked();
    callback prev-clicked();
    callback toggle-menu();

    Rectangle {
        width: 100%;
        height: 100%;
        background: #262626;
        border-radius: 12px;
        border-width: 1px;
        border-color: #383838;
        clip: true;

        VerticalLayout {
            padding: 8px;
            spacing: 8px;

            // Compact Bar
            HorizontalLayout {
                height: 40px;
                spacing: 4px;
                alignment: space-between;

                IconButton {
                    icon: @image-url("icons/prev.svg");
                    clicked => { root.prev-clicked(); }
                }

                IconButton {
                    icon: @image-url("icons/play.svg");
                    clicked => { root.play-clicked(); }
                }

                IconButton {
                    icon: @image-url("icons/stop.svg");
                    clicked => { root.stop-clicked(); }
                }

                IconButton {
                    icon: @image-url("icons/next.svg");
                    clicked => { root.next-clicked(); }
                }

                // Divider
                Rectangle {
                    width: 1px;
                    height: 20px;
                    y: 10px;
                    background: #3e3e3e;
                }

                IconButton {
                    icon: @image-url("icons/menu.svg");
                    clicked => { root.toggle-menu(); }
                }
            }

            // Expanded Menu Section (Shows when menu-open == true)
            if root.menu-open : Rectangle {
                background: #1e1e1e;
                border-radius: 8px;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 12px;
                    alignment: center;
                    spacing: 6px;

                    Text {
                        text: "NETCASSETTE MENU";
                        color: #ffffff;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.track-title;
                        color: #888888;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}