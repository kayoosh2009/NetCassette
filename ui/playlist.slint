component MiniControlBtn inherits Rectangle {
    in property <image> icon;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: touch.pressed ? #333333 : (touch.has-hover ? #2a2a2a : transparent);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Image {
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        image-fit: contain;
    }
}

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> is-active: false;
    callback clicked();

    height: 36px;
    border-radius: 7px;
    background: root.is-active ? #2a2a2e : (nav-touch.has-hover ? #222225 : transparent);

    nav-touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        Image {
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            image-fit: contain;
        }

        Text {
            text: root.label;
            color: root.is-active ? #ffffff : (nav-touch.has-hover ? #dddddd : #8a8a96);
            font-size: 11px;
            font-weight: root.is-active ? 700 : 500;
            vertical-alignment: center;
        }
    }
}

export struct SongItem {
    filename: string,
    title: string,
    artist: string,
    has-lyrics: bool,
}

export struct SlintTorrentItem {
    id: int,
    name: string,
    progress: float,
    is-finished: bool,
    live-peers: int,
    size-text: string,
}

export component PlaylistWindow inherits Window {
    title: "NetCassette Library";
    icon: @image-url("icons/play.png");
    width: 680px;
    height: 440px;
    background: #262626;

    in-out property <string> track-title: "No Media Loaded";
    in-out property <string> track-artist: "Ready";
    in-out property <bool> is-playing: false;
    in-out property <image> track-cover: @image-url("icons/play.png");
    in-out property <int> active-tab: 0;
    in-out property <string> magnet-input: "";

    in-out property <[SongItem]> songs-list: [];
    in-out property <[SlintTorrentItem]> swarms-list: [];
    in-out property <string> current-lyrics: "";
    in-out property <bool> show-lyrics: false;

    callback close-clicked();
    callback move-window(length, length);
    callback play-song-clicked(string);
    callback toggle-lyrics-clicked();
    callback add-magnet-clicked();
    callback seed-music-clicked();
    callback play-clicked();
    callback prev-clicked();
    callback next-clicked();
    callback open-music-folder-clicked();

    // Внутренняя панель в стиле кассеты
    Rectangle {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: parent.height - 20px;
        background: #1c1c1c;
        border-radius: 12px;
        border-width: 1px;
        border-color: #383838;
        clip: true;

        VerticalLayout {
            padding: 12px;
            spacing: 0px;

            // Верхняя плашка с перетаскиванием и крестиком
            Rectangle {
                height: 28px;

                TouchArea {
                    width: parent.width - 34px;
                    height: 100%;
                    moved => {
                        root.move-window(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    }
                }

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    alignment: space-between;

                    Text {
                        text: "NETCASSETTE";
                        color: #777777;
                        font-size: 11px;
                        font-weight: 800;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: close-touch.pressed ? #7f1d1d : (close-touch.has-hover ? #3e2020 : transparent);

                        close-touch := TouchArea {
                            clicked => { root.close-clicked(); }
                        }

                        Text {
                            text: "✕";
                            color: close-touch.has-hover ? #f87171 : #888888;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Центральная рабочая зона: Навигация слева + Контент справа
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                padding-top: 8px;
                padding-bottom: 8px;

                // Левая панель навигации
                VerticalLayout {
                    width: 130px;
                    spacing: 4px;

                    NavItem {
                        icon: @image-url("icons/home.png");
                        label: "Главная";
                        is-active: root.active-tab == 0;
                        clicked => { root.active-tab = 0; }
                    }

                    NavItem {
                        icon: @image-url("icons/network.png");
                        label: "Сеть";
                        is-active: root.active-tab == 1;
                        clicked => { root.active-tab = 1; }
                    }

                    NavItem {
                        icon: @image-url("icons/folder.png");
                        label: "Папка";
                        is-active: false;
                        clicked => { root.open-music-folder-clicked(); }
                    }

                    NavItem {
                        icon: @image-url("icons/info.png");
                        label: "Инфо";
                        is-active: root.active-tab == 2;
                        clicked => { root.active-tab = 2; }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }
                }

                // Разделитель
                Rectangle {
                    width: 1px;
                    background: #282828;
                }

                // Правая область с экранами
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    // Экран: Главная (Библиотека кассет)
                    if root.active-tab == 0 : VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        // Верхняя панель библиотеки
                        HorizontalLayout {
                            height: 26px;
                            alignment: space-between;

                            Text {
                                text: "КАССЕТЫ В БИБЛИОТЕКЕ";
                                color: #888888;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            if root.show-lyrics : Rectangle {
                                width: 70px;
                                height: 22px;
                                border-radius: 4px;
                                background: #333338;
                                TouchArea {
                                    clicked => { root.show-lyrics = false; }
                                }
                                Text {
                                    text: "К списку";
                                    color: #ccc;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Если открыт текст песни — показываем вкладыш
                        if root.show-lyrics : Rectangle {
                            vertical-stretch: 1;
                            background: #141416;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #2b2b32;
                            clip: true;

                            Flickable {
                                width: 100%;
                                height: 100%;
                                VerticalLayout {
                                    padding: 14px;
                                    Text {
                                        text: root.current-lyrics;
                                        color: #e0e0e0;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        // Иначе — список найденных кассет
                        if !root.show-lyrics : Rectangle {
                            vertical-stretch: 1;
                            background: #141416;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #26262b;
                            clip: true;

                            Flickable {
                                width: 100%;
                                height: 100%;

                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 4px;

                                    for song in root.songs-list : Rectangle {
                                        height: 44px;
                                        border-radius: 6px;
                                        background: item-touch.pressed ? #2d2d35 : (item-touch.has-hover ? #222228 : transparent);

                                        item-touch := TouchArea {
                                            clicked => { root.play-song-clicked(song.filename); }
                                        }

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 10px;

                                            Text {
                                                text: "📼";
                                                font-size: 14px;
                                                vertical-alignment: center;
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                horizontal-stretch: 1;

                                                Text {
                                                    text: song.title;
                                                    color: #f0f0f0;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    overflow: elide;
                                                }

                                                Text {
                                                    text: song.artist;
                                                    color: #777782;
                                                    font-size: 10px;
                                                    overflow: elide;
                                                }
                                            }

                                            if song.has-lyrics : Rectangle {
                                                width: 50px;
                                                height: 20px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 4px;
                                                background: #202026;

                                                TouchArea {
                                                    clicked => {
                                                        root.play-song-clicked(song.filename);
                                                        root.show-lyrics = true;
                                                    }
                                                }

                                                Text {
                                                    text: "Текст";
                                                    color: #9999aa;
                                                    font-size: 9px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Экран: Сеть
                    if root.active-tab == 1 : VerticalLayout {
                        padding: 10px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 8px;
                            height: 32px;

                            Rectangle {
                                horizontal-stretch: 1;
                                background: #161616;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #333;

                                TextInput {
                                    x: 8px;
                                    y: (parent.height - self.height) / 2;
                                    width: parent.width - 16px;
                                    text <=> root.magnet-input;
                                    font-size: 11px;
                                    color: #fff;
                                    selection-background-color: #555;
                                }
                            }

                            Rectangle {
                                width: 90px;
                                border-radius: 6px;
                                background: dl-touch.pressed ? #2563eb : (dl-touch.has-hover ? #3b82f6 : #1d4ed8);

                                dl-touch := TouchArea {
                                    clicked => { root.add-magnet-clicked(); }
                                }

                                Text {
                                    text: "Скачать";
                                    color: #fff;
                                    font-size: 11px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                width: 110px;
                                border-radius: 6px;
                                background: seed-touch.pressed ? #047857 : (seed-touch.has-hover ? #10b981 : #059669);

                                seed-touch := TouchArea {
                                    clicked => { root.seed-music-clicked(); }
                                }

                                Text {
                                    text: "Поделиться";
                                    color: #fff;
                                    font-size: 11px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            background: #141414;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #262626;
                            clip: true;

                            Flickable {
                                width: 100%;
                                height: 100%;

                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 6px;

                                    for swarm in root.swarms-list : Rectangle {
                                        height: 44px;
                                        background: #1c1c20;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #2a2a30;

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            alignment: space-between;

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 3px;
                                                horizontal-stretch: 1;

                                                Text {
                                                    text: swarm.name;
                                                    color: #fff;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    overflow: elide;
                                                }

                                                Text {
                                                    text: "Прогресс: " + Math.round(swarm.progress * 100) + "% (" + swarm.size-text + ") | Пиров: " + swarm.live-peers;
                                                    color: #888;
                                                    font-size: 10px;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Экран: Инфо
                    if root.active-tab == 2 : Rectangle {
                        Text {
                            text: "NetCassette v1.0\nP2P Music Player";
                            color: #4a4a54;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Нижняя линия воспроизведения
            Rectangle {
                height: 54px;
                background: #161616;
                border-radius: 8px;
                border-width: 1px;
                border-color: #2b2b2b;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 12px;
                    spacing: 12px;

                    // Обложка 1:1
                    Rectangle {
                        width: 38px;
                        height: 38px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #333333;
                        background: #202020;
                        clip: true;

                        Image {
                            width: 100%;
                            height: 100%;
                            source: root.track-cover;
                            image-fit: cover;
                        }
                    }

                    // Что сейчас играет
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: root.track-title;
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: root.track-artist;
                            color: #888888;
                            font-size: 10px;
                            overflow: elide;
                        }
                    }

                    // Кнопки управления
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: end;

                        MiniControlBtn {
                            y: (parent.height - self.height) / 2;
                            icon: @image-url("icons/prev.png");
                            clicked => { root.prev-clicked(); }
                        }

                        MiniControlBtn {
                            y: (parent.height - self.height) / 2;
                            icon: root.is-playing ? @image-url("icons/stop.png") : @image-url("icons/play.png");
                            clicked => { root.play-clicked(); }
                        }

                        MiniControlBtn {
                            y: (parent.height - self.height) / 2;
                            icon: @image-url("icons/next.png");
                            clicked => { root.next-clicked(); }
                        }
                    }
                }
            }
        }
    }
}