component MiniControlBtn inherits Rectangle {
    in property <image> icon;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: touch.pressed ? #333333 : (touch.has-hover ? #2a2a2a : transparent);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Image {
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        image-fit: contain;
    }
}

export component PlaylistWindow inherits Window {
    title: "NetCassette";
    icon: @image-url("icons/play.png");
    width: 680px;
    height: 440px;
    background: #262626;

    in-out property <string> track-title: "No Media Loaded";
    in-out property <string> track-artist: "Ready";
    in-out property <bool> is-playing: false;
    in-out property <image> track-cover: @image-url("icons/play.png");

    callback close-clicked();
    callback play-clicked();
    callback prev-clicked();
    callback next-clicked();

    // Внутренняя панель в стиле кассеты
    Rectangle {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: parent.height - 20px;
        background: #1c1c1c;
        border-radius: 12px;
        border-width: 1px;
        border-color: #383838;
        clip: true;

        VerticalLayout {
            padding: 12px;
            spacing: 0px;

            // Верхняя плашка с крестиком закрытия
            HorizontalLayout {
                height: 28px;
                alignment: space-between;

                Text {
                    text: "NETCASSETTE";
                    color: #777777;
                    font-size: 11px;
                    font-weight: 800;
                    letter-spacing: 1.5px;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: close-touch.pressed ? #7f1d1d : (close-touch.has-hover ? #3e2020 : transparent);

                    close-touch := TouchArea {
                        clicked => { root.close-clicked(); }
                    }

                    Text {
                        text: "✕";
                        color: close-touch.has-hover ? #f87171 : #888888;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Чистая зона для будущего контента
            Rectangle {
                vertical-stretch: 1;
            }

            // Нижняя линия воспроизведения
            Rectangle {
                height: 54px;
                background: #161616;
                border-radius: 8px;
                border-width: 1px;
                border-color: #2b2b2b;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 12px;
                    spacing: 12px;

                    // Обложка 1:1
                    Rectangle {
                        width: 38px;
                        height: 38px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #333333;
                        background: #202020;
                        clip: true;

                        Image {
                            width: 100%;
                            height: 100%;
                            source: root.track-cover;
                            image-fit: cover;
                        }
                    }

                    // Что сейчас играет
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: root.track-title;
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: root.track-artist;
                            color: #888888;
                            font-size: 10px;
                            overflow: elide;
                        }
                    }

                    // Кнопки управления
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: end;

                        MiniControlBtn {
                            y: (parent.height - self.height) / 2;
                            icon: @image-url("icons/prev.png");
                            clicked => { root.prev-clicked(); }
                        }

                        MiniControlBtn {
                            y: (parent.height - self.height) / 2;
                            icon: root.is-playing ? @image-url("icons/stop.png") : @image-url("icons/play.png");
                            clicked => { root.play-clicked(); }
                        }

                        MiniControlBtn {
                            y: (parent.height - self.height) / 2;
                            icon: @image-url("icons/next.png");
                            clicked => { root.next-clicked(); }
                        }
                    }
                }
            }
        }
    }
}